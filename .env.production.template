NODE_ENV=production
PORT=3000
SERVER_URL=<SERVER_URL>

# MongoDB 连接配置
# 注意：MONGODB_URI 中的密码如果包含特殊字符，必须进行 URL 编码
# 常见字符编码：! → %21  @ → %40  # → %23  $ → %24  % → %25  & → %26
# 例如：密码 "pass!@#" 应写为 "pass%21%40%23"
MONGODB_URI=mongodb://<MONGO_ROOT_USERNAME>:<MONGO_ROOT_PASSWORD_URL_ENCODED>@mongodb:27017/ele_admin?authSource=admin
MONGO_ROOT_USERNAME=<MONGO_ROOT_USERNAME>
MONGO_ROOT_PASSWORD=<MONGO_ROOT_PASSWORD>

# MongoDB 初始化变量（密码使用原始值，不需要 URL 编码）
MONGO_INITDB_ROOT_USERNAME=<MONGO_ROOT_USERNAME>
MONGO_INITDB_ROOT_PASSWORD=<MONGO_ROOT_PASSWORD>

JWT_SECRET=<JWT_SECRET>
JWT_EXPIRES_IN=7d

CORS_ORIGIN=<CORS_ORIGIN>

LOG_RETENTION_DAYS=30
RESPONSE_TIME_ZONE=Asia/Shanghai

UPLOAD_PATH=./src/uploads
UPLOAD_MAX_SIZE=10485760
