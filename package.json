{
  "name": "express-mongodb-backend-api",
  "version": "1.0.0",
  "description": "Express + MongoDB 后台管理后端接口",
  "main": "src/app.js",
  "scripts": {
    "start": "pm2-runtime start pm2.config.js",
    "dev": "nodemon src/app.js",
    "init-data": "node src/scripts/init-data.js",
    "docker:build": "docker build -t express-mongodb-backend ./docker",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.1",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "pm2": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
